        {
          "name": "Get Upload Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response belongs to the requested upload\", function () {",
                  "    const response = pm.response.json();",
                  "    const trackingId =",
                  "        pm.collectionVariables.get(\"trackingId\");",
                  "",
                  "    pm.expect(response.trackingId).to.eql(trackingId);",
                  "});",
                  "",
                  "pm.test(\"Response contains upload statistics\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.fileName).to.be.a(\"string\");",
                  "    pm.expect(response.status).to.be.a(\"string\");",
                  "    pm.expect(response.totalRows).to.be.a(\"number\");",
                  "    pm.expect(response.successRows).to.be.a(\"number\");",
                  "    pm.expect(response.rejectedRows).to.be.a(\"number\");",
                  "    pm.expect(response.createdAt).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Upload status is valid\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    const allowedStatuses = [",
                  "        \"PENDING\",",
                  "        \"PROCESSING\",",
                  "        \"COMPLETED\",",
                  "        \"PARTIALLY_COMPLETED\",",
                  "        \"FAILED\"",
                  "    ];",
                  "",
                  "    pm.expect(allowedStatuses).to.include(response.status);",
                  "});",
                  "",
                  "pm.test(\"Processed row counts are consistent\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.totalRows).to.be.at.least(0);",
                  "    pm.expect(response.successRows).to.be.at.least(0);",
                  "    pm.expect(response.rejectedRows).to.be.at.least(0);",
                  "",
                  "    if (",
                  "        response.status === \"COMPLETED\" ||",
                  "        response.status === \"PARTIALLY_COMPLETED\"",
                  "    ) {",
                  "        pm.expect(",
                  "            response.successRows + response.rejectedRows",
                  "        ).to.eql(response.totalRows);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Correlation ID is returned\", function () {",
                  "    const correlationId =",
                  "        pm.response.headers.get(\"X-Correlation-ID\");",
                  "",
                  "    pm.expect(correlationId).to.be.a(\"string\");",
                  "    pm.expect(correlationId).not.to.be.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
