                "exec": [
                  "pm.test(\"Processing request returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response belongs to the requested upload\", function () {",
                  "    const response = pm.response.json();",
                  "    const trackingId =",
                  "        pm.collectionVariables.get(\"trackingId\");",
                  "",
                  "    pm.expect(response.trackingId).to.eql(trackingId);",
                  "});",
                  "",
                  "pm.test(\"Response contains batch execution information\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.jobExecutionId).to.be.a(\"number\");",
                  "    pm.expect(response.batchStatus).to.be.a(\"string\");",
                  "    pm.expect(response.uploadStatus).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Batch and upload statuses are valid\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    const allowedBatchStatuses = [",
                  "        \"STARTING\",",
                  "        \"STARTED\",",
                  "        \"STOPPING\",",
                  "        \"STOPPED\",",
                  "        \"FAILED\",",
                  "        \"COMPLETED\",",
                  "        \"ABANDONED\",",
                  "        \"UNKNOWN\"",
                  "    ];",
                  "",
                  "    const allowedUploadStatuses = [",
                  "        \"PENDING\",",
                  "        \"PROCESSING\",",
                  "        \"COMPLETED\",",
                  "        \"PARTIALLY_COMPLETED\",",
                  "        \"FAILED\"",
                  "    ];",
                  "",
                  "    pm.expect(allowedBatchStatuses)",
                  "        .to.include(response.batchStatus);",
                  "",
                  "    pm.expect(allowedUploadStatuses)",
                  "        .to.include(response.uploadStatus);",
                  "});",
                  "",
                  "pm.test(\"Correlation ID is returned\", function () {",
                  "    const correlationId =",
                  "        pm.response.headers.get(\"X-Correlation-ID\");",
                  "",
                  "    pm.expect(correlationId).to.be.a(\"string\");",
